config SID_END_DEVICE_SENSOR_LINK_AUTOSWITCH
    bool "Automatically try BLE, FSK, and LoRa links"

if SID_END_DEVICE_SENSOR_LINK_AUTOSWITCH

config SID_END_DEVICE_SENSOR_AUTOSWITCH_FSK_DELAY_S
    int "Delay before switching from BLE to FSK"
    range 1 300
    default 20

config SID_END_DEVICE_SENSOR_AUTOSWITCH_LORA_DELAY_S
    int "Delay before switching from FSK to BLE plus LoRa"
    range 1 600
    default 60

config SID_END_DEVICE_SENSOR_AUTOSWITCH_ROTATE_PERIOD_S
    int "Time to dwell on BLE between link excursions"
    range 60 86400
    default 1800
    help
      Once the initial BLE -> FSK -> BLE+LoRa pass finishes, the demo keeps
      cycling through the same three link states forever so all three get
      exercised occasionally. This is how long it dwells on plain BLE, the link
      that carries telemetry and the Memfault drain, before the next excursion.
      30 minutes leaves BLE undisturbed for a long stretch on a network with
      duty-cycle limits, while still visiting FSK and LoRa a few times an hour
      on a demo that keeps running.

config SID_END_DEVICE_SENSOR_AUTOSWITCH_FALLBACK_TIMEOUT_S
    int "Time to wait for an FSK/LoRa excursion before moving on"
    range 5 600
    default 30
    help
      How long the rotation waits after switching to FSK or to BLE+LoRa before
      checking sid_status link_status_mask and moving on to the next link
      regardless of the result. The FSK phase drops BLE entirely, so this also
      bounds how long the Memfault drain and telemetry uplinks go without any
      link if FSK, or later LoRa, never reports link-up, which is the expected
      outcome on hardware with no gateway on those bands. 30 s gives a real
      gateway time to associate without leaving BLE dark for long when there is
      none.

endif # SID_END_DEVICE_SENSOR_LINK_AUTOSWITCH

